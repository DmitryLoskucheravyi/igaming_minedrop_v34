# ============================================================
# Скопіюй у .env і заповни. .env у git не потрапляє (.gitignore).
#
# ЛОКАЛЬНО можна не заповнювати НІЧОГО: без TELEGRAM_BOT_TOKEN
# сервер вмикає dev-авторизацію, і гра відкривається у звичайному
# браузері на http://localhost:3000
# ============================================================

# --- ЄДИНЕ, ЩО ПОТРІБНО ДЛЯ ТЕЛЕГРАМА ---
# Токен від @BotFather: /newbot, далі /token
# У продакшні (NODE_ENV=production) без нього сервер НЕ стартує:
# без токена нічим перевірити підпис initData, і будь-хто зможе
# надіслати чужий telegram id.
TELEGRAM_BOT_TOKEN=

# https-адреса мініапса. З неї бот робить кнопку «ГРАТИ».
# Обов'язково https і публічний домен — телеграм не відкриє
# ні http, ні localhost.
WEBAPP_URL=

# ============================================================
# Решта має робочі значення за замовчуванням
# ============================================================

NODE_ENV=development
PORT=4000

# MongoDB. Локально: `docker compose up -d` (див. docker-compose.yml),
# далі лишити значення нижче. Порожньо у dev = in-memory сховище,
# стан гравців гине з перезапуском сервера. У продакшні обов'язковий
# (Atlas або свій replica set) — без нього сервер не стартує.
MONGO_URL=mongodb://localhost:27017/minedrop?directConnection=true

# Куди Next проксює /api/* (щоб фронт і API були на одному origin
# і в вебв'ю телеграма не було проблем зі сторонніми запитами)
API_ORIGIN=http://localhost:4000

# CORS. У проді, коли працює проксі Next, не потрібен зовсім.
WEB_ORIGIN=http://localhost:3000

# Скільки секунд initData вважається свіжим.
# Менше — безпечніше, але гравця з довгою сесією почне викидати.
INITDATA_MAX_AGE=86400

# Гра — тільки в телеграмі. true = пускати й у звичайному браузері
# (заголовок x-dev-user) — потрібно лише для sim:e2e чи налагодження.
# У продакшні не працює за побудовою. CRM на /admin від цього не залежить.
DEV_AUTH=false

# USDT TRC20 для депозитів. Адреси заводить адмін у CRM (вкладка «Адреса»).
# Необов'язковий сід: валідна адреса тут додасться при першому старті,
# якщо в БД адрес ще нема. Порожньо — заводиш усе в адмінці.
USDT_TRC20_ADDRESS=

# --- Прод, необов'язково: вебхук замість long polling ---
# Порожньо = long polling (працює скрізь, нічого налаштовувати не треба)
TELEGRAM_WEBHOOK_URL=
# Довільний рядок; телеграм поверне його в заголовку,
# і сервер відкине апдейти, які прийшли не від нього
TELEGRAM_WEBHOOK_SECRET=
